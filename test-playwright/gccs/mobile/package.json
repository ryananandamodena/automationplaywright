{
  "name": "gccs-mobile-tests",
  "version": "1.0.0",
  "description": "GCCS Mobile Automation Testing with Playwright",
  "type": "module",
  "scripts": {
    "test": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js",
    "appium:start": "npx appium",
    "appium:driver:install": "npx appium driver install uiautomator2",
    "test:memu:appium": "node run-memu-appium.mjs",
    "test:memu:appium:strict": "set STRICT_FLOW=true&& node run-memu-appium.mjs",
    "test:memu:appium:repair": "set GCCS_FLOW_MODE=repair&& node run-memu-appium.mjs",
    "test:memu:login": "node run-memu-login.mjs",
    "test:memu:login:example": "set MOBILE_BASE_URL=https://example.com&& node run-memu-login.mjs",
    "test:ui": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js --ui",
    "test:debug": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js --debug",
    "test:headed": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js --headed",
    "test:login": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js -g \"Login\"",
    "test:dashboard": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js -g \"Dashboard\"",
    "test:confirmation": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js -g \"Confirmation\"",
    "test:visit": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js -g \"Visit\"",
    "test:negative": "playwright test mobile_gccs.spec.js --config=playwright.config.mobile.js -g \"NEG\"",
    "report": "playwright show-report mobile-test-report",
    "install:deps": "npm install && npx playwright install chromium && npx playwright install-deps"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "mobile",
    "gccs"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "appium-uiautomator2-driver": "^2.39.0",
    "webdriverio": "^9.1.3"
  },
  "dependencies": {
    "appium": "^2.19.0",
    "dotenv": "^16.0.3"
  }
}
