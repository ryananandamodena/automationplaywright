# ==============================
# AI Autonomous QA Testing Platform
# Environment Configuration Example
# ==============================

APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_qa_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_qa_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
# Generate using: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_example
ENCRYPTION_KEY=super_secret_encryption_key_example

# AI Provider Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=

# Backend API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
